# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API). Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Send-code hook (Dashboard → Authentication → Hooks → Send SMS → HTTPS → secret "v1,whsec_...").
# Only needed where the hook points at /api/auth/send-code (production, or local Supabase).
SEND_CODE_HOOK_SECRET=

# WhatsApp Business Platform (Cloud API) — sends login codes. Leave empty in development:
# codes are then printed in the server log instead.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# An approved template in the "Authentication" category with a copy-code button.
WHATSAPP_AUTH_TEMPLATE=sokofresh_login_code
WHATSAPP_API_VERSION=v23.0
